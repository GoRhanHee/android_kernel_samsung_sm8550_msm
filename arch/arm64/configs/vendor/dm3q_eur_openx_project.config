CONFIG_SEC_DM3Q_PROJECT=y
CONFIG_SEC_DM3Q_EUR_OPENX_PROJECT=y
# S918BXXSAFZG1 EUR/OpenX has no Korean MST hardware.
# Keep the shared MST sources for KOR builds, but disable them for this profile.
# CONFIG_MST_LDO is not set
# CONFIG_MST_ARCH_QCOM is not set
# CONFIG_MST_V2 is not set
# CONFIG_MFC_CHARGER is not set
# CONFIG_MST_PCR is not set
CONFIG_SEC_PANEL_NOTIFIER=m
CONFIG_LPS22HH_FACTORY=y
CONFIG_FLIP_COVER_DETECTOR_FACTORY=y
CONFIG_CHARGER_PCA9481=m
CONFIG_REGULATOR_S2MPB03=m
CONFIG_EPEN_WACOM_WEZ02=m
CONFIG_UWB_SR200=y
CONFIG_SENSORS_QBT2000=m
CONFIG_SENSORS_TSL2585=m
CONFIG_FLICKER_PWM_CALIBRATION=y
CONFIG_SENSORS_VL53L8=m
CONFIG_SENSORS_VL53L8_SUPPORT_UAPI=y
CONFIG_SENSORS_VL53L8_QCOM=y
CONFIG_SENSORS_LAF_FAILURE_DEBUG=y
CONFIG_TOUCHSCREEN_STM_SPI=m
