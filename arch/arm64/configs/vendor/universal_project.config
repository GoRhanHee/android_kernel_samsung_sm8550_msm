# Samsung Kalama universal project
CONFIG_SEC_UNIVERSAL_PROJECT=y

# Galaxy S23 / S23+ / S23 Ultra shared hardware
CONFIG_SEC_PANEL_NOTIFIER=m
CONFIG_FLIP_COVER_DETECTOR_FACTORY=y
CONFIG_CHARGER_PCA9481=m
CONFIG_SENSORS_QBT2000=m
CONFIG_SENSORS_TSL2585=m
CONFIG_FLICKER_PWM_CALIBRATION=y
CONFIG_TOUCHSCREEN_STM_SPI=m
CONFIG_WIRELESS_CHARGER_S2MIW04=m

# Galaxy S23+ additions
CONFIG_UWB_SR200=y

# Galaxy S23 Ultra additions
CONFIG_REGULATOR_S2MPB03=m
CONFIG_EPEN_WACOM_WEZ02=m
CONFIG_SENSORS_VL53L8=m
CONFIG_SENSORS_VL53L8_SUPPORT_UAPI=y
CONFIG_SENSORS_VL53L8_QCOM=y
CONFIG_SENSORS_LAF_FAILURE_DEBUG=y

# Galaxy Z Fold5 additions
CONFIG_SEC_PANEL_NOTIFIER_V2=m
CONFIG_GPIO_PCA953X=m
CONFIG_GPIO_PCA953X_IRQ=y
CONFIG_GPIO_PCA953X_RESET=y
# The generic factory identifies LPS22HH and LPS22DF at runtime.
CONFIG_PRESSURE_FACTORY=y
CONFIG_LIGHT_SUB_FACTORY=y
CONFIG_LPS22DF_FACTORY=y
CONFIG_LSM6DSV_FACTORY=y
CONFIG_SUPPORT_DUAL_6AXIS=y
CONFIG_SUPPORT_DUAL_OPTIC=y
CONFIG_SUPPORT_VIRTUAL_OPTIC=y
CONFIG_SUPPORT_DUAL_OPTIC_BUT_SUPPORT_SINGLE_PROX=y
CONFIG_SUPPORT_REF_ANGLE_WITHOUT_DIGITAL_HALL=y
CONFIG_SUPPORT_DEVICE_MODE=y
CONFIG_INPUT_SEC_TRUSTED_TOUCH=m
CONFIG_SEC_INPUT_MULTI_DEVICE=m
CONFIG_SEC_INPUT_RAWDATA=m
CONFIG_CHARGER_PCA9468=m
CONFIG_MFD_MAX17333=m
CONFIG_MAX77705_USE_EXTRA_FW=y
CONFIG_UI_SOC_PROLONGING=y
CONFIG_ID_USING_BAT_SUBBAT=y
CONFIG_SENSORS_STK6D2X=m
CONFIG_WIRELESS_CHARGER_NU1668=m
CONFIG_UWB_SR100=y
CONFIG_LIMITER_MAX17333=m
CONFIG_SENSORS_GW3X=m
CONFIG_INPUT_DIGITAL_HALL_AKM=m
CONFIG_INPUT_WACOM=m
CONFIG_DUAL_BATTERY=m
CONFIG_TOUCHSCREEN_STM_FST3CA60Y_I2C=m
CONFIG_TOUCHSCREEN_STM_FST2BA61Y_I2C=m
CONFIG_TOUCHSCREEN_STM_FST2CA78Y_SPI=m
CONFIG_MUIC_USE_SISO_OVP=y
CONFIG_SENSORS_A96T396_BENZ2=y
CONFIG_SENSORS_A96T396=m
CONFIG_SENSORS_A96T396_SUB=m
CONFIG_SENSORS_A96T396_2CH=y
CONFIG_SENSORS_FW_VENDOR=y
CONFIG_SENSORS_GRIP_FAILURE_DEBUG=y
CONFIG_SENSORS_ISG6320_SUB=y
CONFIG_IFPMIC_CRC_CHECK=y
CONFIG_SEC_KQ_MESH_QC=m

# Galaxy Z Flip5 additions
CONFIG_I2C_QCOM_CCI=y
CONFIG_SEC_VIBRATOR=m
CONFIG_SEC_VIB_NOTIFIER=y
CONFIG_SUPPORT_SENSOR_FLIP_MODEL=y
CONFIG_SUPPORT_BRIGHTNESS_NOTIFY_FOR_LIGHT_SENSOR=y
CONFIG_SUPPORT_DDI_COPR_FOR_LIGHT_SENSOR=y
CONFIG_SUPPORT_LIGHT_CALIBRATION=y
CONFIG_SUPPORT_PANEL_STATE_NOTIFY_FOR_LIGHT_SENSOR=y
CONFIG_SUPPORT_CONTROL_PROX_LED_GPIO=y
CONFIG_SUPPORT_PROX_CALIBRATION=y
CONFIG_SENSORS_SX9380=m
CONFIG_SENSORS_CORE_AP=y
CONFIG_CHARGER_PCA9482=m
CONFIG_SENSORS_FINGERPRINT_MODULE=y
CONFIG_FINGERPRINT_SECURE=y
CONFIG_SENSORS_FINGERPRINT_QCOM=y
CONFIG_SENSORS_SX9364=m
CONFIG_INPUT_HALL_IC=m
CONFIG_HALL_NOTIFIER=m
CONFIG_HALL_LOGICAL=m
CONFIG_HALL_DUMP_KEY_MODE=m
CONFIG_MST_LDO=m
CONFIG_MST_ARCH_QCOM=y
CONFIG_MST_V2=y
CONFIG_MAX77705_VIBRATOR=m
CONFIG_MAX77705_VIB_FOLD_MODEL=y
CONFIG_PWM_GPCLK=m
CONFIG_PWM_GPCLK_USE_16_BIT_REGISTER=y
CONFIG_COMBO_REDRIVER_PS5169=m
CONFIG_LIMITER_S2ASL01=m
CONFIG_TOUCHSCREEN_SYNAPTICS_SPI=m
CONFIG_TOUCHSCREEN_SYNAPTICS_I2C=m
