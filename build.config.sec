# LEGO defconfig
apply_defconfig_fragment ${KERNEL_DIR}/lego.config vendor/${MSM_ARCH}-gki_defconfig

# DEFCONFIG base
apply_defconfig_fragment ${KERNEL_DIR}/arch/${ARCH}/configs/vendor/${MSM_ARCH}_sec_defconfig vendor/${MSM_ARCH}-gki_defconfig

# Samsung project
case "${SEC_PROJECT_CONFIG:-}" in
	dm1q|dm2q|dm3q|dm3q_eur_openx|q5q|b5q)
		apply_defconfig_fragment \
			${KERNEL_DIR}/arch/${ARCH}/configs/vendor/${SEC_PROJECT_CONFIG}_project.config \
			vendor/${MSM_ARCH}-gki_defconfig
		;;
	"")
		;;
	*)
		echo "Unsupported Samsung project config: ${SEC_PROJECT_CONFIG}" >&2
		exit 1
		;;
esac

# DEBUG_DEFCONFIG
if [[ "${TARGET_BUILD_VARIANT}" != "user" ]]; then
	apply_defconfig_fragment ${KERNEL_DIR}/arch/${ARCH}/configs/vendor/${MSM_ARCH}_sec_${TARGET_BUILD_VARIANT}_defconfig vendor/${MSM_ARCH}-gki_defconfig
fi
